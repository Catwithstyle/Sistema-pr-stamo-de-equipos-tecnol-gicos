{
  "info": {
    "_postman_id": "c1347834-475d-4e04-8c74-b2b488fa9a4a",
    "name": "TecnoUAM - Prestamo de equipos (Servicios Web)",
    "description": "Coleccion de pruebas del Segundo Corte. Ejecutar en orden: primero '0. Autenticacion', luego las carpetas 1 a 4. Cada solicitud incluye pruebas automaticas (pestana Tests). Se puede usar el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date();",
          "const f = (x) => x.toISOString().slice(0, 10);",
          "pm.collectionVariables.set('fechaHoy', f(d));",
          "const e = new Date(d.getTime() + 7*24*3600*1000);",
          "pm.collectionVariables.set('fechaEntrega', f(e));",
          "const a = new Date(d.getTime() - 3*24*3600*1000);",
          "pm.collectionVariables.set('fechaAnterior', f(a));",
          "// codigos unicos: se generan solo al inicio de cada corrida (Login ADMIN) para poder repetir la coleccion",
          "if (pm.info.requestName === 'Login ADMIN') {",
          "  const s = Date.now().toString().slice(-7);",
          "  pm.collectionVariables.set('codigoA', 'PM-' + s + '-A');",
          "  pm.collectionVariables.set('codigoB', 'PM-' + s + '-B');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Autenticacion (ejecutar primero)",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda el JWT del administrador en la variable adminToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve token JWT\", () => pm.expect(j.token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Rol ADMIN\", () => pm.expect(j.rol).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminToken\", j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
