# Copiar a .env (o exportar las variables) ANTES de iniciar el backend.
# NO subir el archivo .env al repositorio.

# Base de datos PostgreSQL (coinciden con docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/tecnouam
DB_USER=tecnouam
DB_PASSWORD=cambia-esta-clave

# Secreto para firmar el JWT: minimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Origenes permitidos para el frontend React (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Contrasenas de las cuentas de prueba
SEED_ADMIN_PASSWORD=Admin123*
SEED_USER_PASSWORD=User123*
